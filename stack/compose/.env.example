# stack/compose/.env.example — non-secret placeholders ONLY (REQ-SEC-02).
# Copy to .env (git-ignored) and fill real values at deploy time. Do NOT commit .env.

# --- stack-core-owned refs ---
PULSE_RENDERED_DIR=../rendered
PVE_TOKEN=placeholder-pve-token-not-a-real-credential
PULSE_VM_RETENTION=6
# (No NAS_TOKEN / NAS_EXPORTER_PORT: a nas-api host is a direct node_exporter scrape now —
# issue #4. The opt-in TrueNAS-API-exporter override recipe owns its own credential env.)

# Grafana admin bootstrap. Compose defaults both to `admin`; override for any non-local deploy.
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
# pve-exporter auth identity (the token secret itself is PVE_TOKEN above).
PVE_USER=pulse@pve
PVE_TOKEN_NAME=pulse
PVE_VERIFY_SSL=false

# --- estate-channel refs (NOT read by any stack-core config; listed so the operator resolves them) ---
# Names come from the consumer's declared channels; resolved only inside rendered estate routing.
OPSGENIE_WEBHOOK=https://example.invalid/placeholder-webhook
SLACK_TOKEN=placeholder-slack-token-not-a-real-credential

# --- alerting refs (05 §5.5; non-secret placeholders / secret references only — REQ-SEC-01) ---
# Estate identity for vmalert -external.label (REQ-RULE-04). Non-secret.
PULSE_ESTATE_NAME=${PULSE_ESTATE_NAME}
# External dead-man receiver URL (pulse-deadman); a secret reference resolved at deploy (REQ-DEAD-01/03).
PULSE_DEADMANSSWITCH_URL=${PULSE_DEADMANSSWITCH_URL}
# Automation-webhook mirror receiver URL (pulse-webhook-mirror); a secret reference (REQ-HOOK-01).
PULSE_WEBHOOK_MIRROR_URL=${PULSE_WEBHOOK_MIRROR_URL}

# --- web-app slot refs (07-slot-reconciliation.md; --profile web only — REQ-LIVE-02/STATE-05/DRILL-02) ---
# Estate declared timezone for timezone-explicit display; IANA zone e.g. "America/Chicago".
# Absent → UTC with an explicit "TZ not configured" marker (charter invariant 10).
PULSE_ESTATE_TZ=UTC
# OPTIONAL: browser-reachable Grafana origin for deep links. Unset → links render disabled with an
# actionable tooltip (never a guessed URL, CON-04). Deploy-toolkit runbooks own the real value.
PULSE_GRAFANA_URL=
# OPTIONAL: Gatus evaluation-freshness threshold in seconds for the liveness gate. Default 300.
PULSE_GATUS_STALE_SECONDS=300
