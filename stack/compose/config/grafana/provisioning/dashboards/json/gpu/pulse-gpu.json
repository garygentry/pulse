{
  "uid": "pulse-gpu",
  "title": "Pulse — GPU",
  "schemaVersion": 39,
  "editable": false,
  "tags": ["pulse", "gpu"],
  "timezone": "",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "annotations": { "list": [] },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "DS",
        "type": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "current": { "selected": false, "text": "VictoriaMetrics", "value": "pulse-victoriametrics" },
        "hide": 0
      },
      {
        "name": "instance",
        "type": "query",
        "label": "Host",
        "datasource": "${DS}",
        "query": "label_values(pulse_command_signal_up{signal=\"gpu\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GPU signal up",
      "datasource": "${DS}",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "blind" }, "1": { "text": "up" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS}",
          "legendFormat": "{{instance}}",
          "expr": "pulse_command_signal_up{instance=~\"$instance\",signal=\"gpu\"}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "GPU utilization %",
      "datasource": "${DS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS}",
          "legendFormat": "{{instance}} · gpu {{gpu}}",
          "expr": "pulse_gpu_utilization_ratio{instance=~\"$instance\"} * 100"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GPU memory used",
      "datasource": "${DS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS}",
          "legendFormat": "{{instance}} · gpu {{gpu}}",
          "expr": "pulse_gpu_memory_used_bytes{instance=~\"$instance\"}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "GPU temperature",
      "datasource": "${DS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "celsius" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS}",
          "legendFormat": "{{instance}} · gpu {{gpu}}",
          "expr": "pulse_gpu_temperature_celsius{instance=~\"$instance\"}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "GPU fan %",
      "description": "Optional series pulse_gpu_fan_speed_ratio: the vBIOS fan target across all fans. 0% at idle is normal on zero-RPM cards.",
      "datasource": "${DS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "noValue": "not reported by this GPU" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS}",
          "legendFormat": "{{instance}} · gpu {{gpu}}",
          "expr": "pulse_gpu_fan_speed_ratio{instance=~\"$instance\"} * 100"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GPU power draw vs limit · $instance",
      "description": "Optional series pulse_gpu_power_draw_watts (solid) against the enforced pulse_gpu_power_limit_watts (dashed red), one panel per host. Cards without power telemetry (e.g. some laptop/low-end parts) show the limit only, with a 'draw not reported' legend entry.",
      "datasource": "${DS}",
      "repeat": "instance",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": {
        "defaults": { "unit": "watt", "min": 0, "noValue": "not reported by this GPU" },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "C" },
            "properties": [
              { "id": "custom.hideFrom", "value": { "legend": false, "tooltip": true, "viz": true } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS}",
          "legendFormat": "{{instance}} · gpu {{gpu}} draw",
          "expr": "pulse_gpu_power_draw_watts{instance=~\"$instance\"}"
        },
        {
          "refId": "B",
          "datasource": "${DS}",
          "legendFormat": "{{instance}} · gpu {{gpu}} limit",
          "expr": "pulse_gpu_power_limit_watts{instance=~\"$instance\"}"
        },
        {
          "refId": "C",
          "datasource": "${DS}",
          "legendFormat": "draw not reported by this GPU",
          "expr": "absent(pulse_gpu_power_draw_watts{instance=~\"$instance\"}) * 0"
        }
      ]
    },
    {
      "id": 8,
      "type": "state-timeline",
      "title": "GPU throttle reasons",
      "description": "Optional series pulse_gpu_throttle_active{reason}: power_cap, thermal, hw_slowdown, from nvidia-smi clocks_event_reasons.active. Each lane is the value at a scrape (30s by default), so a throttle shorter than the scrape interval can be missed: use this to correlate, not to alert.",
      "datasource": "${DS}",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 29 },
      "options": { "showValue": "never", "mergeValues": true, "rowHeight": 0.8 },
      "fieldConfig": {
        "defaults": {
          "noValue": "not reported by this GPU",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "clear", "color": "green" },
                "1": { "text": "throttling", "color": "red" }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS}",
          "legendFormat": "{{instance}} · gpu {{gpu}} · {{reason}}",
          "expr": "pulse_gpu_throttle_active{instance=~\"$instance\"}"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Top GPU processes by VRAM",
      "datasource": "${DS}",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 37 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "VRAM" }, "properties": [{ "id": "unit", "value": "bytes" }] }
        ]
      },
      "options": { "sortBy": [{ "displayName": "VRAM", "desc": true }] },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "collection_class": true, "host": true, "job": true },
            "indexByName": { "instance": 0, "gpu": 1, "process": 2, "pid": 3, "Value": 4 },
            "renameByName": { "instance": "Host", "gpu": "GPU", "process": "Process", "pid": "PID", "Value": "VRAM" }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS}",
          "format": "table",
          "instant": true,
          "legendFormat": "{{process}} · pid {{pid}}",
          "expr": "topk(20, pulse_gpu_process_memory_bytes{instance=~\"$instance\"})"
        }
      ]
    }
  ]
}
