{
  "schemaMajor": 1,
  "estate": {
    "name": "telegram-fixture",
    "domains": ["telegram.invalid"],
    "timezone": "UTC",
    "deadmanHook": "${PULSE_DEADMANSSWITCH_URL}",
    "provenance": { "file": "estate.yaml", "path": "estate", "line": 1, "col": 1 }
  },
  "hosts": [
    {
      "name": "tg-host",
      "collectionClass": "managed-linux",
      "addresses": ["10.0.2.10"],
      "exporterPorts": [9100],
      "cadvisor": false,
      "deliveryForm": "systemd",
      "provenance": { "file": "estate.yaml", "path": "hosts[0]", "line": 10, "col": 1 }
    }
  ],
  "services": [
    {
      "name": "tg-web",
      "host": "tg-host",
      "kind": "app",
      "managed": true,
      "deepHealth": {
        "endpoint": "https://tg-web.telegram.invalid/healthz",
        "responseMapping": { "web_up": "$.up" },
        "alertExpression": "web_up < 1"
      },
      "provenance": { "file": "estate.yaml", "path": "services[0]", "line": 20, "col": 1 }
    }
  ],
  "channels": [
    {
      "name": "tg-alerts",
      "kind": "telegram",
      "credential": { "kind": "env", "raw": "${TELEGRAM_BOT_TOKEN}", "varName": "TELEGRAM_BOT_TOKEN" },
      "options": { "chat_id": -1002001002003 },
      "provenance": { "file": "estate.yaml", "path": "channels[0]", "line": 30, "col": 1 }
    }
  ],
  "routingOverrides": [
    {
      "severity": "critical",
      "channels": ["tg-alerts"],
      "provenance": { "file": "estate.yaml", "path": "routing_overrides[0]", "line": 40, "col": 1 }
    }
  ],
  "suppressions": []
}
