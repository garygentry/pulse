{
  "schemaMajor": 1,
  "estate": {
    "name": "quiet-fixture",
    "domains": ["quiet.invalid"],
    "timezone": "America/Chicago",
    "deadmanHook": "${PULSE_DEADMANSSWITCH_URL}",
    "provenance": { "file": "estate.yaml", "path": "estate", "line": 1, "col": 1 }
  },
  "hosts": [
    {
      "name": "quiet-host",
      "collectionClass": "managed-linux",
      "addresses": ["10.0.4.10"],
      "exporterPorts": [9100],
      "cadvisor": true,
      "deliveryForm": "compose",
      "provenance": { "file": "estate.yaml", "path": "hosts[0]", "line": 10, "col": 1 }
    }
  ],
  "services": [
    {
      "name": "quiet-db",
      "host": "quiet-host",
      "kind": "database",
      "managed": true,
      "backupFreshness": { "signal": "restic", "threshold": "24h" },
      "provenance": { "file": "estate.yaml", "path": "services[0]", "line": 20, "col": 1 }
    }
  ],
  "channels": [
    {
      "name": "quiet-chat",
      "kind": "chat",
      "credential": { "kind": "env", "raw": "${SLACK_TOKEN}", "varName": "SLACK_TOKEN" },
      "provenance": { "file": "estate.yaml", "path": "channels[0]", "line": 30, "col": 1 }
    }
  ],
  "routingOverrides": [],
  "suppressions": [
    {
      "class": "known-expected",
      "rationale": "Nightly restic snapshot briefly restarts the database container during the backup window.",
      "target": "service=\"quiet-db\"",
      "provenance": { "file": "estate.yaml", "path": "suppressions[0]", "line": 40, "col": 1 }
    }
  ]
}
